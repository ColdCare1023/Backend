# Copiar a `serverless.env` (no versionado) y completar con los datos de la
# página Overview y de la API key del deployment en la consola de EMQX Cloud.
# Ver docs/operacion/HU-44_banco_serverless.md.

# Overview → Connection Information → Address (sin puerto).
SERVERLESS_MQTT_HOST=xxxxxxxx.ala.us-east-1.emqxsl.com

# Access Control → Client Authentication: usuario del backend.
SERVERLESS_MQTT_USERNAME=backend_service
SERVERLESS_MQTT_PASSWORD=

# Distinto del backend de Railway si los dos apuntan al mismo deployment.
SERVERLESS_MQTT_CLIENT_ID=backend-banco-serverless

# Overview → REST API: copiar la dirección base tal como la muestra la
# consola (el backend le agrega /clients/<id>) y crear una API key del
# deployment (App ID y App Secret; el secreto se muestra una sola vez).
SERVERLESS_API_URL=
SERVERLESS_API_KEY=
SERVERLESS_API_SECRET=
