# Base de datos
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/farmacia_db

# JWT
JWT_SECRET_KEY=clave_secreta_larga_y_aleatoria_cambiar_en_produccion
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# MQTT - EMQX Cloud Serverless
MQTT_HOST=tu-instancia.emqx.cloud
MQTT_PORT=8883
MQTT_USERNAME=backend_service
MQTT_PASSWORD=token_seguro
MQTT_CLIENT_ID=backend-farmacia-cdl
MQTT_TLS_ENABLED=true

# Entorno
ENVIRONMENT=development

# Protección de la API (DoS de capa aplicación)
API_RATE_LIMIT_HABILITADO=true
API_RATE_LIMIT_MAX_SOLICITUDES=240
API_RATE_LIMIT_VENTANA_SEGUNDOS=60
MAX_BODY_BYTES=65536
# Tope de claves/JTI en memoria para que IPs o tickets aleatorios no crezcan
# sin límite. Para varias instancias se requiere un almacén compartido con TTL.
SECURITY_STATE_MAX_ENTRIES=10000

# Mínimo privilegio de dispositivos: en estricto solo devices provisionados
# en la tabla `devices` pueden registrar lecturas (recomendado en producción)
DEVICE_REGISTRY_ESTRICTO=true

# Producción: URLs reales, HTTPS y secretos fuera del repositorio.
# Nunca uses los valores de ejemplo en un despliegue.
ALLOWED_HOSTS=["api.tu-dominio.example"]
CORS_ORIGINS=["https://app.tu-dominio.example"]

# Acceso con Google (RF-17, método alternativo). Opcional.
# Google verifica la IDENTIDAD; la AUTORIZACIÓN sigue siendo la tabla `users`:
# solo entran correos ya dados de alta por un administrador, y el rol sale de
# la base de datos. No crea usuarios.
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
