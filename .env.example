# Base de datos. En Railway: ${{Postgres.DATABASE_URL}} (postgresql:// se normaliza a asyncpg).
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/farmacia_db

# JWT
JWT_SECRET_KEY=clave_secreta_larga_y_aleatoria_cambiar_en_produccion

# Clave HMAC de la cadena de trazabilidad (eslabones v3). Obligatoria en
# producción, distinta de JWT_SECRET_KEY, fuera de la base de datos.
# Generar con: openssl rand -hex 32
TRAZABILIDAD_HMAC_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# MQTT - EMQX Cloud Serverless
MQTT_HOST=tu-instancia.emqx.cloud
MQTT_PORT=8883
MQTT_USERNAME=backend_service
MQTT_PASSWORD=token_seguro
MQTT_CLIENT_ID=backend-farmacia-cdl
MQTT_TLS_ENABLED=true
# CA privada del broker (banco local). Vacío con EMQX Cloud (CA pública).
MQTT_CA_FILE=

# Entorno
ENVIRONMENT=development

# Detrás de un proxy inverso (Railway, Nginx...): IPs/redes del proxy cuyas
# cabeceras X-Forwarded-For se aceptan (la lee uvicorn). Sin esto todos los
# clientes comparten la IP del proxy en las cuotas; con "*" la IP es
# falsificable si el proxy no reemplaza la cabecera del cliente.
# FORWARDED_ALLOW_IPS=10.0.0.0/8

# Intentos de login fallidos tolerados por cuenta (además de por IP)
LOGIN_CUENTA_MAX_INTENTOS=10
LOGIN_CUENTA_VENTANA_SEGUNDOS=900

# Protección de la API (DoS de capa aplicación)
API_RATE_LIMIT_HABILITADO=true
API_RATE_LIMIT_MAX_SOLICITUDES=240
API_RATE_LIMIT_VENTANA_SEGUNDOS=60
MAX_BODY_BYTES=65536
# Verificaciones de cadena / reportes simultáneos por proceso, y streams SSE
# abiertos por usuario (por encima: 503 / 429).
OPERACIONES_COSTOSAS_CONCURRENTES=2
SSE_MAX_STREAMS_POR_USUARIO=3
# Tope de claves/JTI en memoria para que IPs o tickets aleatorios no crezcan
# sin límite. Para varias instancias se requiere un almacén compartido con TTL.
SECURITY_STATE_MAX_ENTRIES=10000

# Mínimo privilegio de dispositivos: en estricto solo devices provisionados
# en la tabla `devices` pueden registrar lecturas (recomendado en producción)
DEVICE_REGISTRY_ESTRICTO=true

# API de administración del broker (EMQX, HTTP Basic con API key). El backend la
# usa para expulsar la sesión de un dispositivo al revocar/rotar y, con
# BROKER_USUARIOS_MODO=api, para crear y eliminar sus credenciales en la
# autenticación integrada de EMQX (usuario = device_id, contraseña = token).
# Vacío = el token emitido no queda aprovisionado en el broker.
BROKER_API_URL=
BROKER_API_KEY=
BROKER_API_SECRET=
# Quién gestiona los usuarios de dispositivo en el broker: api (EMQX 5 completo o Dedicated:
# el backend los crea y elimina) | manual (EMQX Cloud Serverless: su API no tiene endpoints de
# usuarios; se crean y retiran en la consola y el backend lo informa como pendiente).
BROKER_USUARIOS_MODO=api

# Producción: URLs reales, HTTPS y secretos fuera del repositorio.
# Nunca uses los valores de ejemplo en un despliegue.
# En Railway incluir healthcheck.railway.app: el healthcheck llega con ese Host.
ALLOWED_HOSTS=["api.tu-dominio.example","healthcheck.railway.app"]
CORS_ORIGINS=["https://app.tu-dominio.example"]

# Acceso con Google (RF-17, método alternativo). Opcional.
# Google verifica la IDENTIDAD; la AUTORIZACIÓN sigue siendo la tabla `users`:
# solo entran correos ya dados de alta por un administrador, y el rol sale de
# la base de datos. No crea usuarios.
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=

# BE-025: recuperación de contraseña por correo. Usa el SMTP de las alertas
# (SMTP_ENABLED, SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASSWORD, SMTP_FROM);
# sin SMTP, POST /api/auth/recuperar-password responde 503 y el administrador
# restablece la contraseña desde la gestión de usuarios. Página del frontend
# que recibe el enlace (el token viaja en el fragmento #token=); HTTPS en
# producción.
PASSWORD_RESET_URL=https://app.tu-dominio.example/restablecer-password

# Modelo preventivo temporal (docs/ml/06_BACKEND_INTEGRATION.md).
# desactivado | sombra (registra predicciones sin decidir) | activo (solo modelo APPROVED_FOR_DEPLOYMENT)
IA_PREVENTIVO_MODO=desactivado
IA_PREVENTIVO_VERSION=
IA_PREVENTIVO_SHA256=

# HU-20: modelo Random Forest legado (entrenado con datos sintéticos).
# experimental (por defecto): su clase se guarda marcada como experimental y
# no abre alertas preventivas | desactivado: no se ejecuta | activo: abre alertas.
IA_LEGADO_MODO=experimental
# HU-46: criterio que debe cumplir una versión del modelo para activarse
# (por_incidente | f1). Ambos se calculan y se reportan.
IA_CRITERIO_PRINCIPAL=por_incidente

# HU-54: SIN_DATOS cuando el nodo calla N veces su intervalo de captura (el nodo
# lo informa en estado_nodo; 30 s de fábrica). La vigilancia corre cada PERIODO.
SIN_DATOS_N_INTERVALOS=3
SIN_DATOS_PERIODO_SEGUNDOS=30

# HU-53: aviso por correo de excursión crítica. Transporte `smtp` (SSL 465 o
# STARTTLS 587) o `http_api` (API compatible con Resend), para plataformas que
# restringen el SMTP saliente. SMTP_ENABLED se acepta como sinónimo de EMAIL_ENABLED.
EMAIL_ENABLED=false
EMAIL_TRANSPORTE=smtp
EMAIL_FROM=
EMAIL_DESTINO_RESPALDO=
FRONTEND_URL=
EMAIL_API_URL=https://api.resend.com/emails
EMAIL_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SEGURIDAD=starttls
SMTP_USER=
SMTP_PASSWORD=
NOTIFICACION_MAX_INTENTOS=3
NOTIFICACION_COOLDOWN_MINUTOS=15
ALERTA_VENTANA_NORMALIZACION_MINUTOS=15
# HU-07: antigüedad máxima (horas) de una lectura reenviada desde el buffer del nodo.
# Más vieja que esto va a cuarentena (timestamp_demasiado_antiguo). 168 = 7 días.
LECTURA_ANTIGUEDAD_MAX_HORAS=168

# HU-35: segundos de apertura continua de la puerta (MC-38) que se destacan como prolongada.
PUERTA_UMBRAL_PROLONGADA_SEGUNDOS=60
